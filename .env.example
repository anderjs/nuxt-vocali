# App runtime
NODE_ENV=development
APP_ENV=server
AWS_REGION=eu-north-1

# Logging
LOG_LEVEL=info

# AWS resources
S3_BUCKET_NAME=vocali-transcriptions
DYNAMODB_TABLE_NAME=transcriptions
COGNITO_USER_POOL_ID=eu-north-1_example
# Required only when invoking the file-processing worker outside Terraform-managed Lambda.
PROCESS_TRANSCRIPTION_FUNCTION_NAME=vocali-process-transcription

# Speechmatics
SPEECHMATICS_API_URL=https://asr.api.speechmatics.com
SPEECHMATICS_API_KEY=
SPEECHMATICS_API_TIMEOUT_MS=15000

# Frontend Cognito (public Nuxt runtime config)
# These values are safe for the browser. Do not add Google client secrets here.
NUXT_PUBLIC_API_BASE_URL=https://bqlc2tygw5.execute-api.eu-north-1.amazonaws.com
NUXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id
NUXT_PUBLIC_COGNITO_USER_POOL_ID=eu-north-1_example
NUXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.<region>.amazoncognito.com
NUXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NUXT_PUBLIC_COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/login
NUXT_PUBLIC_COGNITO_SCOPE=openid email profile aws.cognito.signin.user.admin
