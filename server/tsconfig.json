{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "aws-lambda"
    ],
    "outDir": "./dist"
  },
  "include": [
    "handlers/**/*.ts",
    "services/**/*.ts",
    "repositories/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
