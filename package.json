{
  "name": "vocali",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:backend": "jest --config jest.config.cjs --runInBand --roots tests/server",
    "typecheck:lambda": "tsc -p server/tsconfig.json --noEmit",
    "build:lambdas": "esbuild server/handlers/*.ts --platform=node --target=node20 --bundle --format=cjs --outdir=server/dist --outbase=server/handlers",
    "typecheck": "nuxt typecheck",
    "test:frontend": "jest --config jest.config.cjs --runInBand --roots tests/app",
    "test": "npm run test:backend && npm run test:frontend",
    "e2e:run": "NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000 NUXT_PUBLIC_COGNITO_USER_POOL_ID=eu-north-1_aaaaaaaaaa NUXT_PUBLIC_COGNITO_CLIENT_ID=12345678901234567890123456 NUXT_PUBLIC_COGNITO_DOMAIN=example.auth.eu-north-1.amazoncognito.com NUXT_PUBLIC_COGNITO_REDIRECT_URI=http://127.0.0.1:3000/auth/callback NUXT_PUBLIC_COGNITO_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000/login start-server-and-test \"nuxi build && NITRO_HOST=127.0.0.1 NITRO_PORT=3000 nuxi preview\" http://127.0.0.1:3000 \"cypress run\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/client-lambda": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@aws-sdk/util-dynamodb": "^3.996.8",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^1.0.1",
    "@speechmatics/browser-audio-input": "^2.0.4",
    "@speechmatics/real-time-client": "^8.5.1",
    "aws-amplify": "^6.20.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.8",
    "cypress": "^15.20.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "start-server-and-test": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.9"
  }
}
