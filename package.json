{
  "name": "vocali",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev  --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck:lambda": "tsc -p server/tsconfig.json --noEmit",
    "build:lambdas": "esbuild server/handlers/*.ts --platform=node --target=node20 --bundle --format=cjs --outdir=server/dist --outbase=server/handlers",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/lib-dynamodb": "^3.1104.0",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^1.0.1",
    "aws-amplify": "^6.20.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.19.8",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.9"
  }
}
