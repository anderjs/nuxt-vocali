aws_region = "eu-north-1"

bucket_name         = "vocali-s3"
frontend_bucket_name = "vocali-frontend-unique-name"
dynamodb_table_name = "transcriptions"

cognito_user_pool_id          = "eu-north-1_XXXXXXXXX"
cognito_user_pool_client_id   = "existing-app-client-id"
cognito_user_pool_client_name = "existing-app-client-name"
cognito_domain_prefix         = "vocali-dev-unique-prefix"

cognito_callback_urls = [
  "http://localhost:3000/auth/callback",
]

cognito_logout_urls = [
  "http://localhost:3000/login",
]

google_client_id     = "your-google-oauth-client-id.apps.googleusercontent.com"
google_client_secret = "never-commit-real-google-client-secret"

# Permanent server-side key. Never expose this value through Nuxt runtimeConfig.public.
speechmatics_api_key = "never-commit-real-speechmatics-api-key"

api_lambda_runtime = "nodejs20.x"


api_cors_allowed_origins = [
  "http://localhost:3000",
  "http://127.0.0.1:3000",
]
