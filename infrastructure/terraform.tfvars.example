aws_region = "eu-north-1"

bucket_name         = "vocali-s3"
dynamodb_table_name = "vocali-app-table"

cognito_user_pool_id          = "eu-north-1_XXXXXXXXX"
cognito_user_pool_client_id   = "existing-app-client-id"
cognito_user_pool_client_name = "existing-app-client-name"
cognito_domain_prefix         = "vocali-dev-unique-prefix"

cognito_callback_urls = [
  "http://localhost:3000/auth/callback",
]

cognito_logout_urls = [
  "http://localhost:3000/login",
]

google_client_id     = "your-google-oauth-client-id.apps.googleusercontent.com"
google_client_secret = "never-commit-real-google-client-secret"

api_lambda_runtime = "nodejs20.x"
